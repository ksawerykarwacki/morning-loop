# an adopter's own config never belongs in the shared package
agent-manager-config.*.yml
!agent-manager-config.template.yml
!skills/agent-manager-config.template.yml
!skills/agent-manager-config.engineer.yml
# local run artefacts
briefs/
delivery-receipts/
launchd*.log
*.before-v3.1
.DS_Store

# a filled-in runner and plist carry your absolute paths. Only the *.template
# files are shared; the configured copies are yours and must not land here.
scripts/run-prep.sh
scripts/run-prep.opencode.sh
com.morning-loop.prep.plist

# commands/ is the canonical source. A .claude/ inside the package would be a
# second copy, and would make doctor report commands as installed when they are
# only sitting in the clone.
.claude/

# opencode workspace artefacts
.omo/

# Windows pendants of the above: only the *.template.ps1 files are shared.
scripts/run-prep.ps1
scripts/register-prep-task.ps1
taskscheduler*.log
